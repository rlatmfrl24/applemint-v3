# Public browser and SSR configuration
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase access
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=replace_with_service_role_secret

# Optional internal jobs. Leave empty to disable only the related feature.
CRAWL_INTERNAL_SECRET=
YOUTUBE_API_KEY=

# Optional Web Push. Keep false unless every VAPID value is configured.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com

# Optional diagnostics
LOG_LEVEL=info
DEBUG_CRAWL=false
