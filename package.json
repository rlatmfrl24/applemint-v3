{
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" next dev",
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" next build",
		"start": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" next start",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint . --error-on-warnings",
		"lint:fix": "biome lint --write .",
		"deadcode": "knip",
		"check": "biome check . --error-on-warnings && pnpm deadcode && pnpm typecheck",
		"verify": "biome check . --error-on-warnings && pnpm deadcode && pnpm test && pnpm test:db && pnpm build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:db": "supabase test db",
		"typecheck": "tsc --noEmit --incremental false",
		"e2e:prepare": "node scripts/e2e/prepare-local.mjs",
		"test:e2e": "pnpm run e2e:prepare && playwright test",
		"test:e2e:ui": "pnpm run e2e:prepare && playwright test --ui",
		"security:collect-alerts": "node scripts/security/collect-alerts.mjs",
		"security:baseline": "node scripts/security/create-baseline.mjs",
		"security:gate": "node scripts/security/security-gate.mjs",
		"security:overrides": "node scripts/security/check-overrides.mjs"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toggle-group": "^1.1.16",
		"@supabase/ssr": "0.12.3",
		"@supabase/supabase-js": "^2.110.7",
		"@tanstack/react-query": "5.101.4",
		"cheerio": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"geist": "^1.7.0",
		"linkifyjs": "^4.3.2",
		"lucide-react": "^0.577.0",
		"next": "16.2.12",
		"next-themes": "^0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"sonner": "^2.0.5",
		"tailwind-merge": "^3.5.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "1.62.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "24.13.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitest/coverage-v8": "4.1.10",
		"cross-env": "^10.1.0",
		"knip": "6.29.0",
		"tailwindcss": "4.2.1",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"next>postcss": "8.5.20",
			"next>sharp": "0.35.3"
		}
	}
}
